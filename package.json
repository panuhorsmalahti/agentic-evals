{
  "name": "agentic-evals",
  "version": "2.1.0",
  "description": "Library for Agentic Engineering Evals",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/shims', 'dist/shims', { recursive: true })\"",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "author": "Panu Horsmalahti",
  "license": "MIT",
  "dependencies": {
    "openevals": "^0.1.4"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@types/node": "^22.20.5",
    "ai": "^7.0.128",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  }
}
